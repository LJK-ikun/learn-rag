# 复制成 .env 再把值填上：  cp .env.example .env
# .env 已在 .gitignore 里，真实 key 不会被提交。

# ============ 向量化（Embedding）============
# 用阿里云百炼 DashScope 的 OpenAI 兼容模式。
# 为什么不用 DeepSeek：它只有对话接口，压根没有 /embeddings 端点。
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v4
# 向量维度。留空 = 用模型默认值（v4 默认 1024）。
# 填 512 可以省一半存储，质量掉多少会在 M1 文档里做实验对比。
EMBEDDING_DIM=

# ============ 对话（Chat）============
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
CHAT_MODEL=deepseek-v4-flash

# ============ 语料位置 ============
# 面试笔记在另一个仓库里，这里直接指过去，不复制文件（避免两份真相）。
INTERVIEW_DIR=D:/Project/my_code/interview
